{
  "ts-node": {
    "esm": true,
    "require": ["tsconfig-paths/register"],
    "experimentalSpecifierResolution": "node",
  },
  "compilerOptions": {
    "jsx": "react",
    "allowSyntheticDefaultImports": true,
    "target": "ES2016",
    "module": "CommonJS",
    "rootDir": "./",
    "moduleResolution": "node",
    "baseUrl": "src",
    "resolveJsonModule": true,
    "allowJs": true,
    "outDir": "./build",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "@*": ["./Services/*"],
      "@Common/*": ["./Common/*"],
      "@Utils/*": ["./Utils/*"],
      "@Config/*": ["./Config/*"],
      "@Models/*": ["./Models/*"],
      "@Controllers/*": ["./Controllers/*"],
      "@Middlewares/*": ["./Middlewares/*"],
      "@Routes/*": ["./Routes/*"],
      "@Types/*": ["./Types/*"],
      "@Constants/*": ["./Constants/*"]
    }
  },
  "include": ["src"],
  "files": ["\\", "src", "src/decs.d.ts"]
}
